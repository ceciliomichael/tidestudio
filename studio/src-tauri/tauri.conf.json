{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TideStudio",
  "version": "0.1.0",
  "identifier": "studio.tide.local",
  "build": {
    "beforeDevCommand": "npm run prepare:llama && npm run build:api-gateway && npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run prepare:llama && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TideStudio",
        "width": 1280,
        "height": 820,
        "minWidth": 640,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
